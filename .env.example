# Template for .env — copy to .env and fill in real values:
#   cp .env.example .env
# Plain KEY=value only: no quotes, no 'export', no inline comments.

DB_USERNAME=postgres
DB_PASSWORD=changeme

# Must be Base64-encoded and at least 256 bits (32 bytes) for HMAC-SHA256.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=

# Gemini Developer API key — free tier, no credit card.
# Get one at https://aistudio.google.com/apikey
#
# Leave this line COMMENTED OUT if you are not using task drafting. An empty
# GEMINI_API_KEY= is worse than an absent one: Spring only falls back to the
# ':not-configured' default in application.properties when the property is missing
# entirely, so a present-but-empty value is passed to the Google GenAI starter, which
# validates the key at startup and aborts the whole application.
#GEMINI_API_KEY=
